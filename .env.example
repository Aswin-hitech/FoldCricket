# HandCricket Live – Environment Configuration

# -------------------------------------------------------------
# Supabase Storage Bucket (for Saving IP & Visit Details)
# -------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
# Use your Supabase Secret key (recommended for storage bucket writes) or Publishable key:
SUPABASE_SECRET_KEY=your-supabase-secret-key
# Or:
# SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# SUPABASE_KEY=your-supabase-key
SUPABASE_BUCKET_NAME=ip-logs

# -------------------------------------------------------------
# Vercel Deployment & Frontend (Vite)
# -------------------------------------------------------------
# When deployed to Vercel, set VITE_BACKEND_URL to your hosted backend URL
# (e.g. Render, Railway, Fly.io, or VPS)
VITE_BACKEND_URL=https://your-backend.onrender.com

# -------------------------------------------------------------
# Python Backend (Flask + Socket.IO)
# -------------------------------------------------------------
SECRET_KEY=change-this-in-production
FLASK_DEBUG=false
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173,http://localhost:3000
SOCKETIO_ASYNC_MODE=threading

# Game rules (configurable)
DELIVERY_TIMEOUT_SECONDS=15
RECONNECT_GRACE_SECONDS=120
ALLOWED_OVERS=1,2,5,10
ROOM_CAPACITY=20

# Creator dashboard (/creator). Set a long random value in production; the
# dashboard asks for it and sends it as X-Creator-Key. When unset, the API is
# reachable from loopback only (local development).
CREATOR_DASHBOARD_KEY=
