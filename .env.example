# HandCricket Live – Environment Configuration

# -------------------------------------------------------------
# Neon Postgres (Player Accounts)
# -------------------------------------------------------------
# Connection string from the Neon dashboard. Use the pooled connection URL and
# keep sslmode=require. Accounts are written here and mirrored locally so
# friend lists and search keep working.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# The account tables are created automatically on first boot. The full
# user-data schema (friends, stats, achievements, DMs, invites) can be applied
# once with backend/neon/accounts_schema.sql.

# -------------------------------------------------------------
# Supabase Storage Bucket (for Saving IP & Visit Details)
# -------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
# Use your Supabase Secret key (recommended for storage bucket writes) or Publishable key:
SUPABASE_SECRET_KEY=your-supabase-secret-key
# Or:
# SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# SUPABASE_KEY=your-supabase-key
SUPABASE_BUCKET_NAME=ip-logs

# -------------------------------------------------------------
# Vercel Deployment & Frontend (Vite)
# -------------------------------------------------------------
# When deployed to Vercel, set VITE_BACKEND_URL to your hosted backend URL
# (e.g. Render, Railway, Fly.io, or VPS)
VITE_BACKEND_URL=https://your-backend.onrender.com

# -------------------------------------------------------------
# Python Backend (Flask + Socket.IO)
# -------------------------------------------------------------
SECRET_KEY=change-this-in-production
FLASK_DEBUG=false
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173,http://localhost:3000
SOCKETIO_ASYNC_MODE=threading

# Game rules (configurable)
DELIVERY_TIMEOUT_SECONDS=20
RECONNECT_GRACE_SECONDS=120
ALLOWED_OVERS=1,2,5,10
ROOM_CAPACITY=20

# -------------------------------------------------------------
# Player accounts
# -------------------------------------------------------------
# sqlite   = keep accounts in the local backend/handcricket.db file
# postgres = store users + sessions in the Neon Postgres database above
# auto     = use Postgres when DATABASE_URL is set, else sqlite
# In Postgres mode the two account tables are created automatically at boot
# if they are missing. Check GET /health -> "account_store" to confirm.
USER_STORE=auto
ACCOUNT_SESSION_DAYS=30

# -------------------------------------------------------------
# Creator dashboard (/creator). Sign-in is username + password; the server
# issues a signed token valid for CREATOR_SESSION_HOURS. Only a password HASH
# is configured - never the plaintext. Generate one with:
#   python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your-password'))"
# CREATOR_DASHBOARD_KEY is an optional automation bypass header (X-Creator-Key).
# The default credentials remain aswin_dashboard / 12345678.
CREATOR_USERNAME=aswin_dashboard
# CREATOR_PASSWORD_HASH=scrypt:32768:8:1$...
# Legacy plaintext variables are hashed in memory at startup:
# CREATOR_PASSWORD=12345678
CREATOR_SESSION_HOURS=12
CREATOR_DASHBOARD_KEY=
